# Public canonical URL used for metadata, structured data, robots.txt, and sitemap.xml.
# Required; must be https in production (assertServerEnv refuses to boot otherwise).
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase. The publishable key is safe in browser code only when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only secret key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Optional server/CI-only PostgreSQL URL for migration tools. Prefer Direct
# Connection (:5432) with IPv6, otherwise Shared Pooler Session mode (:5432).
# The Next.js runtime does not read this value.
SUPABASE_DB_URL=

# Google OAuth client, used only by the Supabase CLI (supabase/config.toml
# auth.external.google) to run Google sign-in locally via `supabase start`.
# The Next.js runtime does not read these; the hosted project's Google
# provider credentials are configured separately in the Supabase Dashboard.
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

# One-time bootstrap of the first admin user, consumed only by
# `npm run bootstrap:admin` (scripts/bootstrap-admin.mjs). The Next.js runtime
# does not read these. Remove ADMIN_BOOTSTRAP_PASSWORD from .env.local (or
# rotate it) after the first successful login.
ADMIN_BOOTSTRAP_USER_ID=
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_password_16+_chars
ADMIN_BOOTSTRAP_DISPLAY_NAME=Cherry Doodle Admin

# Cloudinary Programmable Media. The API secret is server-only. Public catalog
# media uses delivery type `upload`; order customizations use `authenticated`.
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
CLOUDINARY_PRIVATE_READ_URL_TTL_SECONDS=900

# Razorpay Standard Checkout. Keep test mode enabled until the full payment,
# webhook, fulfilment, refund, and reconciliation flow has been validated.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_with_dashboard_key_id
RAZORPAY_KEY_SECRET=replace_with_dashboard_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_dashboard_test_webhook_secret
# Set ONLY while rotating the webhook secret. The dashboard change and the deploy of
# the new secret cannot be simultaneous; during the overlap both are accepted, so no
# delivery signed with the old one is lost. Remove it once rotation is complete.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# Values are expressed in the catalog currency's smallest unit (INR paise) --
# 299900 = Rs 2999, 4900 = Rs 49. REQUIRED in production: the server refuses to boot
# without them, rather than falling back to a development default and silently
# shipping orders for a fraction of the intended charge.
CHECKOUT_FREE_SHIPPING_THRESHOLD_MINOR=299900
CHECKOUT_FLAT_SHIPPING_MINOR=4900

# Resend transactional email (order confirmations, payment incidents, newsletter
# confirmations). The sending domain cherrydoodle.in must be verified in the Resend
# dashboard (SPF + DKIM DNS records) before anything will send.
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM_ADDRESS=Cherry Doodle <orders@cherrydoodle.in>
# Optional. Where customer replies land; omit for no Reply-To header.
EMAIL_REPLY_TO_ADDRESS=

# Application secrets. Use at least 32 random bytes per value. The server refuses to
# boot (instrumentation.ts -> assertServerEnv) if any of these is missing, still a
# placeholder, or shorter than 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUEST_CART_TOKEN_PEPPER=replace_with_a_random_secret
APP_HMAC_SECRET=replace_with_a_random_secret
CRON_SECRET=replace_with_a_random_secret

# Distributed rate limiting (Upstash Redis REST). Optional in dev (in-memory
# fallback), but REQUIRED in production: without it, rate-limited routes fail
# closed with 503, and the boot-time env check will refuse to start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional observability/release metadata.
LOG_LEVEL=info
DEPLOYMENT_VERSION=development

# Sentry error tracking. DSN is not secret and is used both client- and
# server-side. Leave blank to disable — the SDK no-ops safely without it.
# SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are build-time-only secrets used
# to upload source maps; omit them and builds simply skip that upload step.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog product analytics. Leave blank to disable — analytics calls become
# no-ops. NEXT_PUBLIC_POSTHOG_HOST defaults to PostHog Cloud's US region;
# point it at your own host for the EU region or a self-hosted instance.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Cron Monitoring for app/api/internal/jobs/*. Defaults live in
# lib/observability/cron-monitor.ts and are PLACEHOLDERS — set these to match
# whatever actually triggers each job (Vercel Cron, an external scheduler,
# etc.), or Sentry will report false-positive "missed run" alerts.
CRON_SCHEDULE_CHECKOUT_CLEANUP=
CRON_SCHEDULE_EMAIL_DISPATCH=
CRON_SCHEDULE_MEDIA_CLEANUP=
CRON_SCHEDULE_PAYMENT_RECONCILIATION=
